{
  "name": "lumen-hollow",
  "version": "1.0.0",
  "description": "A night-forest tower defense game for the browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "sim": "vite build --ssr src/sim/cli.ts --outDir .sim --emptyOutDir --logLevel warn && node .sim/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "9.39.5",
    "globals": "^16.0.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
